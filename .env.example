# ─────────────────────────────────────────────────────────────
#  Marta's Halloween Night — environment variables
#  Copy to `.env.local` for local development, and add the same
#  keys in Vercel → Project → Settings → Environment Variables.
#  NONE of these are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → "Project URL"
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → "service_role" secret key.
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OPTIONAL. Leave both unset and /admin opens without a password
# (anyone who knows the /admin link can see and edit the guest list).
# Set them to put a password on the dashboard.
# ADMIN_PASSWORD=choose-a-long-unique-passphrase
# ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters   # openssl rand -base64 48

# Optional: the public URL of the site (used for social preview links).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
